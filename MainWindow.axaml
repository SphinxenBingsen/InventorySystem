<!-- MainWindow.axaml -->
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:InventorySystem"
    x:Class="InventorySystem.MainWindow"
    x:DataType="local:MainWindow"
    Width="900"
    Height="600"
    Title="Inventory Robot Demo">

  <!-- ====== Templates so orders render nicely ====== -->
  <Window.Resources>
    <!-- How an Order renders in the list -->
    <DataTemplate x:Key="OrderTemplate" x:DataType="local:Order">
      <StackPanel Margin="6" Spacing="2">
        <TextBlock FontWeight="Bold"
                   Text="{Binding OrderLines.Count, StringFormat=Order ({0} lines)}"/>
        <ItemsControl ItemsSource="{Binding OrderLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:OrderLine">
              <TextBlock Text="{Binding Item.Name, StringFormat=• {0}}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- How a processed Order renders -->
    <DataTemplate x:Key="ProcessedOrderTemplate" x:DataType="local:Order">
      <StackPanel Margin="6" Spacing="2">
        <TextBlock FontWeight="Bold"
                   Text="{Binding OrderLines.Count, StringFormat=Processed ({0} lines)}"/>
        <ItemsControl ItemsSource="{Binding OrderLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:OrderLine">
              <TextBlock Text="{Binding Item.Name, StringFormat=• {0}}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*">

    <!-- Top controls -->
    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" Spacing="8" Margin="12">
      <Button Content="Process Next Order" Click="ProcessNext_Click" />
      <Button Content="Test Robot Move" Click="TestRobotMove_OnClick" />
      <Button Content="Ping Robot (Log)" Click="PingRobot_OnClick" />
      <TextBlock Text="Total revenue: " Margin="16,0,0,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding TotalRevenue}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Queued -->
    <StackPanel Grid.Row="1" Grid.Column="0" Margin="12" Spacing="8">
      <TextBlock Text="Queued Orders" FontWeight="Bold"/>
      <ListBox ItemsSource="{Binding QueuedOrders}"
               ItemTemplate="{StaticResource OrderTemplate}"
               Height="220"/>
    </StackPanel>

    <!-- Processed -->
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12" Spacing="8">
      <TextBlock Text="Processed Orders" FontWeight="Bold"/>
      <ListBox ItemsSource="{Binding ProcessedOrders}"
               ItemTemplate="{StaticResource ProcessedOrderTemplate}"
               Height="220"/>
    </StackPanel>

    <!-- Status output -->
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="12,0,12,12" Spacing="4">
      <TextBlock Text="Status" FontWeight="Bold"/>
      <ScrollViewer Height="140">
        <TextBlock x:Name="StatusMessages" TextWrapping="Wrap"/>
      </ScrollViewer>
    </StackPanel>

  </Grid>
</Window>
